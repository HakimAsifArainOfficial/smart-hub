<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="monetag" content="44607f85ddb9974839490048eb85aa58">

<title>Smart Hub</title>

<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#172033">

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  padding:28px 18px;
  background:#172033;
  color:white;
  text-align:center;
}

header h1{
  margin:0 0 6px;
  font-size:30px;
}

header p{
  margin:0;
  opacity:.85;
  font-size:15px;
}

main{
  max-width:900px;
  margin:auto;
  padding:20px;
}

.home-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.menu-button{
  border:0;
  border-radius:16px;
  padding:20px;
  background:white;
  color:#172033;
  font-size:17px;
  box-shadow:0 2px 12px #0001;
  cursor:pointer;
  text-align:left;
  width:100%;
  transition:.15s;
}

.menu-button:hover{
  transform:translateY(-2px);
  box-shadow:0 5px 16px #0002;
}

.icon{
  display:block;
  font-size:28px;
  margin-bottom:9px;
}

.menu-title{
  display:block;
  font-weight:bold;
  margin-bottom:5px;
}

.menu-description{
  display:block;
  font-size:13px;
  color:#667085;
  line-height:1.4;
}

footer{
  text-align:center;
  padding:35px 10px;
  color:#667085;
  font-size:13px;
}

footer a{
  color:#175cd3;
  text-decoration:none;
}

@media(max-width:650px){
  .home-grid{
    grid-template-columns:1fr;
  }

  header h1{
    font-size:27px;
  }

  main{
    padding:16px;
  }
}
</style>
</head>

<body>

<header>
  <h1>Smart Hub</h1>
  <p>Your simple all-in-one web hub</p>
</header>

<main>

  <div class="home-grid">

    <!-- Browser & Search Engine -->
    <button class="menu-button"
      onclick="window.location.href='./browser.html'">

      <span class="icon">🌐</span>

      <span class="menu-title">
        Browser &amp; Search Engine
      </span>

      <span class="menu-description">
        Browsers, search engines and Incognito Mode
      </span>

    </button>


    <!-- Service -->
    <button class="menu-button"
      onclick="window.location.href='./services.html'">

      <span class="icon">📱</span>

      <span class="menu-title">
        Service
      </span>

      <span class="menu-description">
        Useful websites and online services
      </span>

    </button>


    <!-- News -->
    <button class="menu-button"
      onclick="window.location.href='./news.html'">

      <span class="icon">📰</span>

      <span class="menu-title">
        News
      </span>

      <span class="menu-description">
        News and information from different sources
      </span>

    </button>


    <!-- More -->
    <button class="menu-button"
      onclick="window.location.href='./more.html'">

      <span class="icon">➕</span>

      <span class="menu-title">
        More
      </span>

      <span class="menu-description">
        More Smart Hub features and settings
      </span>

    </button>

  </div>

</main>

<footer>

  <a href="https://www.youtube.com/@HakimAsifArainOfficial"
     target="_blank"
     rel="noopener">
    YouTube @HakimAsifArainOfficial
  </a>

  &nbsp; • &nbsp;

  <a href="https://hakimasifarainofficial.blogspot.com/"
     target="_blank"
     rel="noopener">
    Blog
  </a>

  &nbsp; • &nbsp;

  <a href="mailto:justice.alliance.intl@proron.me">
    Complaints
  </a>

</footer>

<script>
if ("serviceWorker" in navigator) {
  window.addEventListener("load", function () {
    navigator.serviceWorker.register("./sw.js")
      .then(function () {
        console.log("Smart Hub PWA is ready");
      })
      .catch(function (error) {
        console.error("Smart Hub PWA error:", error);
      });
  });
}
</script>

</body>
</html>
